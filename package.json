{
	"name": "observability-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node --enable-source-maps dist/server.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"packageManager": "pnpm@12.8.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"dependencies": {
		"express": "^5.2.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
